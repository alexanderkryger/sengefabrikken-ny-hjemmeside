{%- if section.blocks.size > 0 -%}
  {%- comment -%}
    Sengefabrikken: the section can be shown as a rounded box in the page width, with optional manual colors (overriding
    the color scheme) and a dotted "blueprint" background. The anchor lets product templates link to the section (e.g.
    "#specification").
  {%- endcomment -%}
  {%- liquid
    assign has_manual_colors = false
    if section.settings.background != blank or section.settings.text_color != blank or section.settings.border_color != blank
      assign has_manual_colors = true
    endif
  -%}

  <style>
    #shopify-section-{{ section.id }} {
      --specifications-dot-color: {{ section.settings.dot_color.rgb | default: '163 150 142' }} / .5;
    }

    #shopify-section-{{ section.id }} .specifications--boxed {
      border-radius: .75rem;
      overflow: hidden;
    }

    #shopify-section-{{ section.id }} .specifications--dotted {
      background-image: radial-gradient(circle at 15px 15px, rgb(var(--specifications-dot-color)) 1px, transparent 1.5px);
      background-size: 30px 30px;
    }

    {%- comment -%}With image spacing, the image is shown uncropped in a 60/40 split with 5rem around it (as on the current site){%- endcomment -%}
    {%- if section.settings.image != blank and section.settings.add_image_spacing -%}
      #shopify-section-{{ section.id }} .section-split__column--image img {
        object-fit: contain;
      }

      @media screen and (min-width: 1000px) {
        #shopify-section-{{ section.id }} .section-split {
          {%- if section.settings.image_position == 'end' -%}
            --section-split-grid-template-columns: minmax(0, .4fr) minmax(0, .6fr);
          {%- else -%}
            --section-split-grid-template-columns: minmax(0, .6fr) minmax(0, .4fr);
          {%- endif -%}
          padding-inline: calc(5rem - var(--container-gutter));
          column-gap: calc(5rem - var(--container-gutter));
        }
      }
    {%- endif -%}
  </style>

  <div {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handle }}"{% endif %} {% if section.settings.use_page_width %}class="container section-spacing"{% endif %}>
  <div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }} {% if section.settings.use_page_width %}specifications--boxed{% endif %} {% if section.settings.show_dots %}specifications--dotted{% endif %}" {% if has_manual_colors %}style="{% render 'surface', background: section.settings.background, text_color: section.settings.text_color, border_color: section.settings.border_color %}"{% endif %}>
    {%- capture section_header -%}
      {%- if section.settings.subheading != blank or section.settings.title != blank or section.settings.content != blank -%}
        <div class="prose {% if section.settings.layout == 'stacked' and section.settings.image == blank %}prose-justify-center{% endif %}">
          {%- render 'subheading', content: section.settings.subheading -%}
          {%- render 'heading', content: section.settings.title, balance_text: true, style: section.settings.heading_size, html_tag: 'h2' -%}

          {%- if section.settings.content != blank -%}
            <div class="max-w-sm">
              {{- section.settings.content -}}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endcapture -%}

    {%- capture section_content -%}
      {%- if section.settings.collapse_attributes -%}
        {%- comment -%}
        ---------------------------------------------------------------------------------------------
        RENDER THE ACCORDION STYLE
        ---------------------------------------------------------------------------------------------
        {%- endcomment -%}
        <div class="accordion-list">
          {%- for block in section.blocks -%}
            {%- comment -%}
              Sengefabrikken: "metaobject_specs" renders one accordion per metaobject entry of a product metafield
              (a list of metaobjects with the fields "title", "content" and "icon"), as the theme editor does not offer
              repeating blocks in this section.
            {%- endcomment -%}
            {%- if block.type == 'metaobject_specs' -%}
              {%- assign metafield_parts = block.settings.metafield | split: '.' -%}

              {%- for entry in product.metafields[metafield_parts[0]][metafield_parts[1]].value -%}
                {%- assign entry_content = entry.content | metafield_tag -%}

                {%- render 'accordion',
                  title: entry.title.value,
                  icon: 'none',
                  custom_icon: entry.icon.value,
                  content: entry_content,
                  uppercase_title: section.settings.uppercase_attribute_title,
                  large: true,
                  block: block
                -%}
              {%- endfor -%}

              {%- continue -%}
            {%- endif -%}

            {%- liquid
              comment
                Sengefabrikken: "accordion" blocks use the same setting ids as the current site's bed-specifications
                section (so the same metaobject can be connected), where "icon" is an image instead of a built-in icon.
              endcomment
              if block.type == 'accordion'
                assign block_icon = 'none'
                assign block_custom_icon = block.settings.icon
              else
                assign block_icon = block.settings.icon
                assign block_custom_icon = block.settings.custom_icon
              endif
            -%}

            {%- render 'accordion',
              title: block.settings.title,
              icon: block_icon,
              custom_icon: block_custom_icon,
              content: block.settings.content,
              uppercase_title: section.settings.uppercase_attribute_title, 
              large: true,
              block: block 
            -%}
            {%- endfor -%}
        </div>
      {%- else -%}
        {%- comment -%}
        ---------------------------------------------------------------------------------------------
        RENDER THE GRID STYLE
        ---------------------------------------------------------------------------------------------
        {%- endcomment -%}
        <table class="specification-table">
          <tbody class="divide-y">
            {%- for block in section.blocks -%}
              {%- if block.type == 'metaobject_specs' -%}
                {%- assign metafield_parts = block.settings.metafield | split: '.' -%}

                {%- for entry in product.metafields[metafield_parts[0]][metafield_parts[1]].value -%}
                  <tr class="specification-table__row" {{ block.shopify_attributes }}>
                    <th scope="row" class="specification-table__row-name {% if section.settings.uppercase_attribute_title %}uppercase{% endif %}">
                      <div class="text-with-icon {% if section.settings.show_attribute_icon_on_top %}text-with-icon--stacked{% endif %}">
                        {%- if entry.icon.value != blank -%}
                          {%- render 'icon', image: entry.icon.value, width: 20, mobile_width: 16 -%}
                        {%- endif -%}

                        {{- entry.title.value -}}
                      </div>
                    </th>

                    <td class="specification-table__row-value prose">
                      {{- entry.content | metafield_tag -}}
                    </td>
                  </tr>
                {%- endfor -%}

                {%- continue -%}
              {%- endif -%}

              {%- liquid
                if block.type == 'accordion'
                  assign block_icon = 'none'
                  assign block_custom_icon = block.settings.icon
                else
                  assign block_icon = block.settings.icon
                  assign block_custom_icon = block.settings.custom_icon
                endif
              -%}

              <tr class="specification-table__row" {{ block.shopify_attributes }}>
                <th scope="row" class="specification-table__row-name {% if section.settings.uppercase_attribute_title %}uppercase{% endif %}">
                  <div class="text-with-icon {% if section.settings.show_attribute_icon_on_top %}text-with-icon--stacked{% endif %}">
                    {%- if block_custom_icon != blank -%}
                      {%- render 'icon', image: block_custom_icon, width: 20, mobile_width: 16 -%}
                    {%- elsif block_icon != 'none' -%}
                      {%- render 'icon' with block_icon, width: 20, mobile_width: 16 -%}
                    {%- endif -%}

                    {{- block.settings.title -}}
                  </div>
                </th>

                <td class="specification-table__row-value prose">
                  {{- block.settings.content -}}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.image != blank -%}
      <div class="section-split {% if section.settings.image_position == 'end' %}section-split--reverse{% endif %}">
        <div class="section-split__column section-split__column--image {% unless section.settings.add_image_spacing %}section-split__column--flushed{% endunless %}">
          {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: sizes: '(max-width: 699px) 100vw, 50vw', widths: '300,400,500,600,800,1000,1200,1400,1600,1800,2000', class: 'size-full' -}}
        </div>

        <div class="section-split__column align-self-start">
          <div class="section-stack">
            {{- section_header -}}
            {{- section_content -}}
          </div>
        </div>
      </div>
    {%- else -%}
      {%- if section.settings.layout == 'split' -%}
        <div class="section-split">
          <div class="section-split__column">
            {{- section_header -}}
          </div>

          <div class="section-split__column">
            {{- section_content -}}
          </div>
        </div>
      {%- else -%}
        <div class="container section-spacing">
          <div class="section-stack {% unless section.settings.use_page_width %}max-w-md{% endunless %} mx-auto">
            {{- section_header -}}
            {{- section_content -}}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.specifications.name",
  "class": "shopify-section--specifications",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_page_width",
      "label": "Brug Sengefabrikken sidebredde",
      "info": "Sektionen vises som en afrundet boks, der er lige så bred som den maks. sidebredde i Theme settings > Sengefabrikken layout.",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Baggrund",
      "info": "Lad felterne stå tomme for at bruge farveskemaet."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekst"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Kant"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Vis prikket baggrund",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Prikfarve",
      "default": "#a3968e",
      "visible_if": "{{ section.settings.show_dots }}"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anker-ID",
      "info": "Bruges til at linke direkte til sektionen, fx med linket \"#specification\".",
      "default": "specification"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image",
      "info": "t:sections.specifications.image_size_recommendation"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:global.layout.layout",
      "options": [
        {
          "value": "split",
          "label": "t:global.layout.layout_options.split"
        },
        {
          "value": "stacked",
          "label": "t:global.layout.layout_options.stacked"
        }
      ],
      "default": "stacked",
      "visible_if": "{{ section.settings.image == blank }}"
    },
    {
      "type": "checkbox",
      "id": "add_image_spacing",
      "label": "t:sections.specifications.add_image_spacing",
      "info": "Viser hele billedet med luft omkring, fordelt 60/40 med teksten på desktop.",
      "default": true,
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.specifications.image_position",
      "options": [
        {
          "value": "start",
          "label": "t:global.position.left"
        },
        {
          "value": "end",
          "label": "t:global.position.right"
        }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "Learn more"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Specifications"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:global.text.heading_size",
      "options": [
        {
          "value": "display-xl",
          "label": "Display XL"
        },
        {
          "value": "display-l",
          "label": "Display L"
        },
        {
          "value": "display-m",
          "label": "Display M"
        },
        {
          "value": "h1",
          "label": "XX-Large"
        },
        {
          "value": "h2",
          "label": "X-Large"
        },
        {
          "value": "h3",
          "label": "Large"
        },
        {
          "value": "h4",
          "label": "Medium"
        },
        {
          "value": "h5",
          "label": "Small"
        },
        {
          "value": "h6",
          "label": "X-Small"
        },
        {
          "value": "h7",
          "label": "XX-Small"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content",
      "default": "<p>Add specification attributes to help your customers choose the most appropriate product or to share brand values.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.specifications.attributes_category"
    },
    {
      "type": "checkbox",
      "id": "collapse_attributes",
      "label": "t:sections.specifications.collapse_attributes",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_attribute_icon_on_top",
      "label": "t:sections.specifications.show_attribute_icon_on_top",
      "default": false,
      "visible_if": "{{ section.settings.collapse_attributes == false }}"
    },
    {
      "type": "checkbox",
      "id": "uppercase_attribute_title",
      "label": "t:sections.specifications.uppercase_attribute_title",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "attribute",
      "name": "t:sections.specifications.blocks.attribute.name",
