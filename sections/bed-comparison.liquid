{%- comment -%}
  Sengefabrikken: comparison of bed models (eg. /pages/sammenlign-kontinental), with a sticky row of the models, groups
  of attributes that open and close, and a bar to start a new comparison (bed type and models, in a drawer). Up to 6
  models are set up, of which the customer compares a few side by side (3 on desktop, 2 on mobile). The models shown
  are kept in the URL (?vis=1,3,4), so that a comparison can be shared.
{%- endcomment -%}

{{- 'bed-comparison.css' | asset_url | stylesheet_tag -}}
{%- comment -%}The option rows of the drawer (bed types and models){%- endcomment -%}
{{- 'product-group.css' | asset_url | stylesheet_tag -}}
<script type="module" src="{{ 'bed-comparison.js' | asset_url }}"></script>

{%- liquid
  assign model_indexes = ''

  for i in (1..6)
    assign product_key = 'product_' | append: i
    if section.settings[product_key] != blank
      assign model_indexes = model_indexes | append: i | append: ','
    endif
  endfor

  assign model_indexes = model_indexes | split: ','
  assign groups = section.blocks | where: 'type', 'row' | map: 'settings' | map: 'group' | uniq
  assign common_blocks = section.blocks | where: 'type', 'common'
  capture drawer_id
    echo 'bed-comparison-drawer-' | append: section.id
  endcapture
-%}

<style>
  #shopify-section-{{ section.id }} {
    --bed-comparison-max-columns: {{ section.settings.columns_desktop }};
  }
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg">
  <bed-comparison class="bed-comparison" max-columns="{{ section.settings.columns_desktop }}" drawer="{{ drawer_id }}" {{ section.shopify_attributes }}>
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="container">
        <div class="bed-comparison__intro prose text-center">
          {%- if section.settings.heading != blank -%}
            <h1 class="h2">{{ section.settings.heading | escape }}</h1>
          {%- endif -%}

          {{- section.settings.text -}}
        </div>
      </div>
    {%- endif -%}

    {%- if model_indexes.size == 0 -%}
      {%- if request.design_mode -%}
        <p class="container text-center text-subdued">Vælg modellerne under "Modeller" i sektionens indstillinger.</p>
      {%- endif -%}
    {%- else -%}
      <div class="container">
        <span class="bed-comparison__sentinel" aria-hidden="true"></span>

        {%- comment -%}The models: sticky while the attributes scroll below them{%- endcomment -%}
        <div class="bed-comparison__models bed-comparison__grid">
          <div class="bed-comparison__label-cell"></div>

          {%- for i in model_indexes -%}
            {%- liquid
              assign product_key = 'product_' | append: i
              assign title_key = 'product_title_' | append: i
              assign highlights_key = 'highlights_' | append: i
              assign model = section.settings[product_key]
              assign highlights = section.settings[highlights_key] | newline_to_br | split: '<br />'
            -%}

            <div class="bed-comparison__model" data-model="{{ i }}">
              <button type="button" class="bed-comparison__remove tap-area" data-remove-model="{{ i }}">
                <span class="sr-only">Fjern {{ section.settings[title_key] | default: model.title | escape }} fra sammenligningen</span>
                {%- render 'icon' with 'close', width: 12 -%}
              </button>

              {%- if section.settings.show_images and model.featured_media != blank -%}
                <a href="{{ model.url }}" class="bed-comparison__model-media" tabindex="-1" aria-hidden="true">
                  {{- model.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 45vw, 300px', widths: '200,300,400,500,600' -}}
                </a>
              {%- endif -%}

              <a href="{{ model.url }}" class="bed-comparison__model-title">{{ section.settings[title_key] | default: model.title | escape }}</a>

              {%- if section.settings[highlights_key] != blank -%}
                <ul class="bed-comparison__model-highlights" role="list">
                  {%- for highlight in highlights -%}
                    {%- assign highlight = highlight | strip -%}
                    {%- if highlight != blank -%}
                      <li>{{ highlight | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              <div class="bed-comparison__model-footer">
                {%- render 'price-list', product: model, context: 'card', alignment: 'center', hide_unit_price: true -%}
                <a href="{{ model.url }}" class="bed-comparison__model-link link">Se mere</a>
              </div>
            </div>
          {%- endfor -%}

          <button type="button" class="bed-comparison__add" aria-controls="{{ drawer_id }}" aria-expanded="false" hidden>
            <span class="bed-comparison__add-icon">{%- render 'icon' with 'quantity-plus', width: 12 -%}</span>
            <span>Tilføj model</span>
          </button>
        </div>

        {%- comment -%}The attributes, by group (eg. "Topmadras", "Garanti"){%- endcomment -%}
        <div class="bed-comparison__groups">
          {%- for group in groups -%}
            {%- liquid
              assign group_open = false
              if section.settings.open_groups == 'all'
                assign group_open = true
              elsif section.settings.open_groups == 'first' and forloop.first
                assign group_open = true
              endif
            -%}

            <details class="bed-comparison__group" {% if group_open %}open{% endif %}>
              <summary class="bed-comparison__group-summary">
                <span class="h3">{{ group | default: 'Generelt' | escape }}</span>
                <span class="bed-comparison__toggle" aria-hidden="true">
                  <span class="bed-comparison__toggle-open">{%- render 'icon' with 'quantity-plus', width: 10 -%}</span>
                  <span class="bed-comparison__toggle-close">Skjul</span>
                </span>
              </summary>

              <div class="bed-comparison__rows">
                {%- for block in section.blocks -%}
                  {%- if block.type != 'row' or block.settings.group != group -%}
                    {%- continue -%}
                  {%- endif -%}

                  <div class="bed-comparison__row bed-comparison__grid {% if block.settings.label == blank %}bed-comparison__row--text{% endif %}" {{ block.shopify_attributes }}>
                    <div class="bed-comparison__label-cell">
                      {%- if block.settings.label != blank -%}
                        <p class="bed-comparison__label">{{ block.settings.label | escape }}</p>
                      {%- endif -%}
                    </div>

                    {%- for i in model_indexes -%}
                      {%- liquid
                        assign value_key = 'value_product_' | append: i
                        assign image_key = 'image_product_' | append: i
                        assign value = block.settings[value_key]
                        assign image = block.settings[image_key]
                      -%}

                      <div class="bed-comparison__value" data-model="{{ i }}">
                        {%- if image != blank -%}
                          {{- image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 45vw, 200px', widths: '200,300,400', class: 'bed-comparison__value-image' -}}
                        {%- endif -%}

                        {%- if value != blank -%}
                          <p>{{ value | escape }}</p>
                        {%- elsif image == blank -%}
                          <p class="bed-comparison__empty">-</p>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endfor -%}
              </div>
            </details>
          {%- endfor -%}
        </div>

        {%- for block in common_blocks -%}
          {%- assign bullets = block.settings.bullets | newline_to_br | split: '<br />' -%}

          <div class="bed-comparison__common" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="h4">{{ block.settings.heading | escape }}</p>
            {%- endif -%}

            <ul class="bed-comparison__common-list" role="list">
              {%- for bullet in bullets -%}
                {%- assign bullet = bullet | strip -%}
                {%- if bullet != blank -%}
                  <li>{%- render 'icon' with 'picto-checked', width: 16 -%}{{ bullet | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%}New comparison: bed type (other comparison pages) and models{%- endcomment -%}
      <div class="bed-comparison__bar">
        <div class="container">
          {%- render 'button', content: 'Start ny sammenligning', style: 'outline', aria_controls: drawer_id -%}
        </div>
      </div>

      <x-drawer id="{{ drawer_id }}" class="drawer color-scheme color-scheme--{{ settings.default_color_scheme.id }}">
        <span class="h5" slot="header">Ny sammenligning</span>

        <div class="v-stack gap-8">
          {%- liquid
            assign has_types = false
            for i in (1..3)
              assign type_label_key = 'type_label_' | append: i
              if section.settings[type_label_key] != blank
                assign has_types = true
              endif
            endfor
          -%}

          {%- if has_types -%}
            <div class="v-stack gap-4">
              <p class="h6">Sengetype</p>

              <div class="product-group-option-list">
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign type_label_key = 'type_label_' | append: i
                    assign type_url_key = 'type_url_' | append: i
                    assign type_image_key = 'type_image_' | append: i
                    assign type_url = section.settings[type_url_key]
                    assign type_image = section.settings[type_image_key]
                  -%}

                  {%- if section.settings[type_label_key] != blank -%}
                    {%- if type_url == blank or type_url == request.path -%}
                      <span class="product-group-option is-selected" aria-current="page">
                    {%- else -%}
                      <a href="{{ type_url }}" class="product-group-option">
                    {%- endif -%}
                      {%- if type_image != blank -%}
                        {{- type_image | image_url: width: 128 | image_tag: loading: 'lazy', class: 'product-group-option__image' -}}
                      {%- else -%}
                        <span></span>
                      {%- endif -%}
                      <span class="product-group-option__title">{{ section.settings[type_label_key] | escape }}</span>
                    {%- if type_url == blank or type_url == request.path -%}
                      </span>
                    {%- else -%}
                      </a>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <fieldset class="v-stack gap-4">
            <legend class="h6">Vælg modeller</legend>
            <p class="text-sm text-subdued" data-pick-hint>Vælg op til {{ section.settings.columns_desktop }} modeller.</p>

            <div class="product-group-option-list">
              {%- for i in model_indexes -%}
                {%- liquid
                  assign product_key = 'product_' | append: i
                  assign title_key = 'product_title_' | append: i
                  assign model = section.settings[product_key]
                -%}

                <label class="bed-comparison__pick">
                  <input type="checkbox" class="sr-only" value="{{ i }}" data-pick-model>
                  <span class="product-group-option">
                    {%- if model.featured_media != blank -%}
                      {{- model.featured_media | image_url: width: 128 | image_tag: loading: 'lazy', class: 'product-group-option__image' -}}
                    {%- else -%}
                      <span></span>
                    {%- endif -%}
                    <span class="product-group-option__title">{{ section.settings[title_key] | default: model.title | escape }}</span>
                    <span class="product-group-option__price">{{ model.price | money }}</span>
                  </span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        </div>

        <dialog-close-button slot="footer" style="display: contents">
          <button type="button" class="button w-full" data-apply-models>Sammenlign valgte</button>
        </dialog-close-button>
      </x-drawer>
    {%- endif -%}
  </bed-comparison>
</div>

{% schema %}
{
  "name": "Sammenlign senge",
  "class": "shopify-section--bed-comparison",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Sammenlign kontinentalsenge"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Modeller side om side på desktop",
      "info": "På mobil sammenlignes 2 modeller ad gangen.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Vis produktbilleder",
      "default": true
    },
    {
      "type": "select",
      "id": "open_groups",
      "label": "Åbne grupper",
      "options": [
        { "value": "first", "label": "Første gruppe" },
        { "value": "all", "label": "Alle grupper" },
        { "value": "none", "label": "Ingen" }
      ],
      "default": "all"
    },
    {
      "type": "header",
      "content": "Modeller",
      "info": "Rækkerne har en værdi og et billede til hver model (Produkt 1 til 6)."
    },
    { "type": "product", "id": "product_1", "label": "Produkt 1" },
    { "type": "text", "id": "product_title_1", "label": "Produkt 1 titel" },
    { "type": "textarea", "id": "highlights_1", "label": "Produkt 1 fremhævet", "info": "Én pr. linje" },
    { "type": "product", "id": "product_2", "label": "Produkt 2" },
    { "type": "text", "id": "product_title_2", "label": "Produkt 2 titel" },
    { "type": "textarea", "id": "highlights_2", "label": "Produkt 2 fremhævet", "info": "Én pr. linje" },
    { "type": "product", "id": "product_3", "label": "Produkt 3" },
    { "type": "text", "id": "product_title_3", "label": "Produkt 3 titel" },
    { "type": "textarea", "id": "highlights_3", "label": "Produkt 3 fremhævet", "info": "Én pr. linje" },
    { "type": "product", "id": "product_4", "label": "Produkt 4" },
    { "type": "text", "id": "product_title_4", "label": "Produkt 4 titel" },
    { "type": "textarea", "id": "highlights_4", "label": "Produkt 4 fremhævet", "info": "Én pr. linje" },
    { "type": "product", "id": "product_5", "label": "Produkt 5" },
    { "type": "text", "id": "product_title_5", "label": "Produkt 5 titel" },
    { "type": "textarea", "id": "highlights_5", "label": "Produkt 5 fremhævet", "info": "Én pr. linje" },
    { "type": "product", "id": "product_6", "label": "Produkt 6" },
    { "type": "text", "id": "product_title_6", "label": "Produkt 6 titel" },
    { "type": "textarea", "id": "highlights_6", "label": "Produkt 6 fremhævet", "info": "Én pr. linje" },
    {
      "type": "header",
      "content": "Sengetyper",
      "info": "Vises under \"Start ny sammenligning\" og linker til de andre sammenligninger."
    },
    { "type": "text", "id": "type_label_1", "label": "Sengetype 1", "default": "Kontinentalseng" },
    { "type": "url", "id": "type_url_1", "label": "Sengetype 1 link" },
    { "type": "image_picker", "id": "type_image_1", "label": "Sengetype 1 billede" },
    { "type": "text", "id": "type_label_2", "label": "Sengetype 2", "default": "Elevationsseng" },
    { "type": "url", "id": "type_url_2", "label": "Sengetype 2 link" },
    { "type": "image_picker", "id": "type_image_2", "label": "Sengetype 2 billede" },
    { "type": "text", "id": "type_label_3", "label": "Sengetype 3", "default": "Boxmadras" },
    { "type": "url", "id": "type_url_3", "label": "Sengetype 3 link" },
    { "type": "image_picker", "id": "type_image_3", "label": "Sengetype 3 billede" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Række",
      "settings": [
        { "type": "text", "id": "group", "label": "Gruppe", "info": "Rækker med samme gruppe vises samlet (fx \"Topmadras\"). Tom gruppe vises som \"Generelt\"." },
        { "type": "text", "id": "label", "label": "Label", "info": "Uden label vises værdierne som en tekst (fx \"Kort om\")." },
        { "type": "text", "id": "value_product_1", "label": "Værdi til Produkt 1" },
        { "type": "image_picker", "id": "image_product_1", "label": "Billede til Produkt 1" },
        { "type": "text", "id": "value_product_2", "label": "Værdi til Produkt 2" },
        { "type": "image_picker", "id": "image_product_2", "label": "Billede til Produkt 2" },
        { "type": "text", "id": "value_product_3", "label": "Værdi til Produkt 3" },
        { "type": "image_picker", "id": "image_product_3", "label": "Billede til Produkt 3" },
        { "type": "text", "id": "value_product_4", "label": "Værdi til Produkt 4" },
        { "type": "image_picker", "id": "image_product_4", "label": "Billede til Produkt 4" },
        { "type": "text", "id": "value_product_5", "label": "Værdi til Produkt 5" },
        { "type": "image_picker", "id": "image_product_5", "label": "Billede til Produkt 5" },
        { "type": "text", "id": "value_product_6", "label": "Værdi til Produkt 6" },
        { "type": "image_picker", "id": "image_product_6", "label": "Billede til Produkt 6" }
      ]
    },
    {
      "type": "common",
      "name": "Fælles for alle",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Overskrift", "default": "Fælles for alle vores senge" },
        { "type": "textarea", "id": "bullets", "label": "Punkter", "info": "Ét pr. linje", "default": "Produceret i Danmark\nPocketfjedre\n7 komfortzoner" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sammenlign senge",
      "blocks": [
        { "type": "row", "settings": { "group": "Garanti", "label": "Rammebrud" } },
        { "type": "common" }
      ]
    }
  ]
}
{% endschema %}
