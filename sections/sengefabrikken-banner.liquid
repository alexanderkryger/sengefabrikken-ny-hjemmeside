{%- comment -%}
  Sengefabrikken: the banners of the collection page as a section, so that they can be used on any page:
  - "Billede" and "Video": a media with an overlay and a text on top (same as the image and video blocks of the
    collection page)
  - "To kolonner": a text (e.g. a quote with its author) next to an image or a video (sengefabrikken-split-promo snippet)
  The blocks use the same settings as on the collection page. With the Sengefabrikken page width, the banners are rounded
  boxes as wide as the page width, otherwise they go from edge to edge.
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .sengefabrikken-banners {
    gap: 1.5rem;
    display: grid;
  }

  {%- if section.settings.use_page_width -%}
    #shopify-section-{{ section.id }} .sengefabrikken-banner {
      border-radius: .75rem;
      overflow: clip;
    }
  {%- else -%}
    #shopify-section-{{ section.id }} .sengefabrikken-split-promo {
      border-radius: 0;
    }
  {%- endif -%}
</style>

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="{% if section.settings.use_page_width %}container{% endif %} section-spacing">
    <div class="sengefabrikken-banners">
      {%- for block in section.blocks -%}
        {%- liquid
          assign preload_media = false

          if forloop.first and section.settings.preload_first
            assign preload_media = true
          endif
        -%}

        {%- case block.type -%}
          {%- when 'sengefabrikken_split' -%}
            {%- render 'sengefabrikken-split-promo', block: block -%}

          {%- else -%}
            <div class="sengefabrikken-banner color-scheme color-scheme--{{ block.settings.color_scheme.id }}" {{ block.shopify_attributes }}>
              <div class="content-box min-h-{{ block.settings.height }}">
                <div class="content-box__background-media with-overlay" style="--overlay: {{ block.settings.overlay_color.rgb }} / {{ block.settings.overlay_opacity | divided_by: 100.0 }}">
                  {%- liquid
                    if block.type == 'image'
                      if block.settings.image != blank
                        render 'media', media: block.settings.image, mobile_media: block.settings.mobile_image, preload: preload_media, sizes: '(max-width: 1400px) 100vw, 1400px'
                      else
                        echo 'lifestyle-1' | placeholder_svg_tag: 'placeholder'
                      endif

                    elsif block.settings.video != blank
                      render 'media', media: block.settings.video, mobile_media: block.settings.mobile_video, autoplay: true, loop: true, muted: true, controls: false, preload: preload_media, show_play_button: false
                    endif
                  -%}
                </div>

                {%- if block.settings.heading != blank or block.settings.content != blank or block.settings.subheading != blank or block.settings.button_text != blank -%}
                  <div class="{{ block.settings.content_position }} {% if block.settings.content_width != blank and block.settings.content_width != 'auto' %}max-w-{{ block.settings.content_width }}{% endif %}">
                    <div class="prose prose-justify-{{ block.settings.content_position | split: '-' | last }}">
                      {%- if block.settings.subheading != blank -%}
                        {%- render 'subheading', content: block.settings.subheading -%}
                      {%- endif -%}

                      {%- if block.settings.heading != blank -%}
                        {%- render 'heading', content: block.settings.heading, style: block.settings.heading_size -%}
                      {%- endif -%}

                      {%- if block.settings.content != blank -%}
                        <div {% if block.settings.content_width == blank or block.settings.content_width == 'auto' %}class="max-w-xs"{% endif %}>
                          {{- block.settings.content -}}
                        </div>
                      {%- endif -%}

                      {%- if block.settings.button_text != blank -%}
                        {%- render 'button', content: block.settings.button_text, href: block.settings.url, style: block.settings.style, external: block.settings.open_in_new_tab -%}
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

