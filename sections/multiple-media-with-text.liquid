      "type": "header",
      "content": "Billede eller video over teksten"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:global.image.image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:global.video.video",
