    {
      "type": "header",
      "content": "Rækkefølge"
    },
    {
      "type": "select",
      "id": "media_position_desktop",
      "label": "Placering af medier på desktop",
      "options": [
        {
          "value": "before_text",
          "label": "Venstre"
        },
        {
          "value": "after_text",
          "label": "Højre"
        }
      ],
      "default": "before_text"
    },
    {
      "type": "select",
      "id": "media_position_mobile",
      "label": "Placering af medier på mobil",
      "options": [
        {
          "value": "before_text",
          "label": "Før tekst"
        },
        {
          "value": "after_text",
          "label": "Efter tekst"
        }
      ],
      "default": "before_text"
    },
    {
      "type": "header",
      "content": "Medier",
      "info": "Tilføj op til 2 billeder eller videoer som blokke."
    },
    {
      "type": "select",
      "id": "media_layout",
      "label": "Layout",
      "options": [
        {
          "value": "overlap",
          "label": "Overlappende"
        },
        {
          "value": "separated",
          "label": "Ved siden af hinanden"
        }
      ],
      "default": "overlap"
    },
    {
      "type": "select",
      "id": "media_alignment",
      "label": "Lodret placering",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Midte"
        },
        {
