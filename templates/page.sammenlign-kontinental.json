        "comparison_row_87mpqy": {
          "type": "row",
          "settings": {
            "group": "Kort om",
            "value_product_1": "Komfort-serien er vores budgetvenlige serie af danskproducerede kvalitetssenge. Skabt til dem, der ønsker en komfortabel seng i et stilrent design - til markedets skarpeste pris.",
            "value_product_2": "Trykaflastende-serien er vores ergonomiske serie af danskproducerede kvalitetssenge. Skabt til dem, der ønsker ekstra aflastning og ergonomisk korrekt støtte - nat efter nat.",
            "value_product_3": "Kølende-serien er vores temperaturregulerende serie af danskproducerede kvalitetssenge. Skabt til dem, der døjer med varmen om natten - og ikke ønsker at gå på kompromis med hverken komfort eller æstetik.",
            "value_product_4": "Luksus-serien er vores mest eksklusive serie af danskproducerede kvalitetssenge. Skabt til dem, der nægter at gå på kompromis med komfort, støtte, æstetik og brug af naturlige materialer.",
            "value_product_5": "Platin-serien er kronjuvelen blandt vores danskproducerede kvalitetssenge. Skabt til den ultimative luksussøgende, kombinerer denne serie fejlfri komfort med førsteklasses materialer og udsøgt design."
          }
        },
