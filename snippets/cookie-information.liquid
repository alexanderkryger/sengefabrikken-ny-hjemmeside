{%- doc -%}
Sengefabrikken: cookie banner of Cookie Information, and the bridge from its consent to the "DataLayer" custom pixel
(Settings > Customer events), which updates the Google Consent Mode on the "consent_update" event. The footer link
"Administrer cookies" opens the banner again (CookieConsent.renew()).
{%- enddoc -%}

<link rel="preconnect" href="https://policy.app.cookieinformation.com" crossorigin>
<script id="CookieConsent" src="https://policy.app.cookieinformation.com/uc.js" data-culture="DA" defer></script>

<script>
  window.addEventListener('CookieInformationConsentGiven', function() {
    var consentMarketing = window.CookieInformation.getConsentGivenFor('cookie_cat_marketing');
    var consentStatistic = window.CookieInformation.getConsentGivenFor('cookie_cat_statistic');

    if (consentMarketing !== undefined && consentStatistic !== undefined) {
      window.Shopify.analytics.publish('consent_update', {
        ad_storage: consentMarketing,
        analytics_storage: consentStatistic
      });
    }
  });
</script>
