{%- doc -%}
Sengefabrikken: on desktop, when the header uses the "drawer" layout, a menu item with a mega menu block opens this panel
next to the menu drawer (on hover or click) instead of replacing the menu. It shows:
- a link to the menu item ("Vis Senge")
- the sub links of the menu item
- the promo blocks of the mega menu block with an image, as image cards with the heading on top
- the promo blocks with a product, as compact product cards (sengefabrikken-product-card snippet), with a heading above

On mobile the theme's own sub panel is used (see the main-menu-drawer snippet).

@param {object} link - the menu item
@param {object} block - the mega menu block matching the menu item
@param {string} id - the ID of the panel
{%- enddoc -%}

{%- capture image_cards -%}
  {%- for i in (1..6) -%}
    {%- liquid
      assign promo_product_setting = 'promo_' | append: i | append: '_product'
      assign promo_image_setting = 'promo_' | append: i | append: '_image'
      assign promo_heading_setting = 'promo_' | append: i | append: '_heading'
      assign promo_link_setting = 'promo_' | append: i | append: '_link'

      assign promo_image = block.settings[promo_image_setting]
      assign promo_heading = block.settings[promo_heading_setting]
      assign promo_link = block.settings[promo_link_setting]
    -%}

    {%- if block.settings[promo_product_setting] == blank and promo_image != blank -%}
      <a {% if promo_link != blank %}href="{{ promo_link }}"{% endif %} class="menu-drawer-flyout__image-card group">
        {{- promo_image | image_url: width: promo_image.width | image_tag: loading: 'lazy', sizes: '440px', widths: '440,880,1320', class: 'zoom-image group-hover:zoom' -}}

        {%- if promo_heading != blank -%}
          <span class="menu-drawer-flyout__image-card-heading">{{ promo_heading }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture product_cards -%}
  {%- for i in (1..6) -%}
    {%- assign promo_product_setting = 'promo_' | append: i | append: '_product' -%}
    {%- assign promo_product = block.settings[promo_product_setting] -%}

    {%- if promo_product != blank -%}
      {%- render 'sengefabrikken-product-card', product: promo_product, compact: true -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div id="{{ id }}" class="menu-drawer-flyout" role="region" aria-label="{{ link.title | escape }}">
  <div class="menu-drawer-flyout__body">
    <a href="{{ link.url }}" class="menu-drawer-flyout__all-link h5 link-reversed">
      {%- if block.settings.flyout_link_text != blank -%}
        {{- block.settings.flyout_link_text -}}
      {%- else -%}
        Vis {{ link.title -}}
      {%- endif -%}
    </a>

    {%- if link.links.size > 0 -%}
      <ul class="menu-drawer-flyout__links unstyled-list" role="list">
        {%- for sub_link in link.links -%}
          <li>
            <a href="{{ sub_link.url }}" class="menu-drawer-flyout__link link-reversed">
              {%- render 'icon' with 'arrow-right', direction_aware: true, width: 12 -%}
              <span>{{ sub_link.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if image_cards != blank -%}
      <div class="menu-drawer-flyout__cards">
        {{- image_cards -}}
      </div>
    {%- endif -%}

    {%- if product_cards != blank -%}
      <div class="menu-drawer-flyout__products">
        {%- if block.settings.flyout_products_heading != blank -%}
          <p class="h6">{{ block.settings.flyout_products_heading }}</p>
        {%- endif -%}

        <div class="menu-drawer-flyout__cards">
          {{- product_cards -}}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
