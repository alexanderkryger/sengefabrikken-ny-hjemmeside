{%- doc -%}
This component display a list of product that can be used in collection, search...

@param {array} products - the list of products to render
@param {string} [id] - the id of the product list (neeeded for carousel)
@param {string} [prefix_id] - an optional prefix that is used to prefix all the inputs. This is useful when we have to output multiple product list on the same page, to avoid any ID conflicts
@param {object} [section_color_scheme] - the color scheme of the section where the product list is used. By default, the theme uses the section.settings.color_scheme so it does not have to be passed explicitly, but it can be overriden if needed
@param {array} [blocks] - the list of blocks from section
@param {boolean} [allow_highlight] - set to true to highlight a product
@param {boolean} [spotlight] - set to true to display a carousel on desktop that shows one product at a time
@param {boolean} [stack] - set to true when products are stacked
@param {boolean} [show_placeholder] - set to true to display placeholder when no product set
@param {boolean} [output_override_attributes] - only for collection page, we allow customers to switch the layout. To avoid CLS, we have to save the attribute in the cart and apply it to the product list. A better approach would be to use container query around cards, but unfortunately we are using subgrid, and currently in browsers, subgrid and container queries can't be used together, so we have to revert to this approach
@param {object} [paginate] - an optional paginate object when product list is rendered in context of collection pages
@param {object} [section]
@param {string} [card_style] - Sengefabrikken: "sengefabrikken" renders the Sengefabrikken card, laid out as one wide card followed by two cards
@param {string} [card_row_background] - Sengefabrikken: background color of the row with the second and third Sengefabrikken cards (full width)
@param {boolean} [card_two_columns] - Sengefabrikken: if set to true, the Sengefabrikken cards that are not wide are shown two per row
{%- enddoc -%}

{%- if card_style == 'sengefabrikken' -%}
  {{- 'sengefabrikken-product-card.css' | asset_url | stylesheet_tag -}}
{%- endif -%}

<product-list {% if id %}id="{{ id }}"{% endif %} class="product-list {% if card_style == 'sengefabrikken' %}product-list--sengefabrikken {% if card_two_columns %}product-list--sengefabrikken-two-columns{% endif %}{% endif %} {% if stack == false or spotlight == false %}product-list--carousel scroll-area bleed{% endif %} {% if spotlight %}product-list--spotlight scroll-area bleed{% if settings.product_listing_spacing == 'none' %}border{% endif %}{% endif %}" {% if output_override_attributes %}mobile-items-per-row="{{ cart.attributes.product_card_mobile_items_per_row | default: section.settings.products_per_row_mobile }}" desktop-layout="{{ cart.attributes.product_card_desktop_layout | default: 'grid' }}"{% endif %}>
  {%- liquid
    assign has_active_filters = false

    for filter in collection.filters
      if filter.type == 'price_range'
        if filter.max_value.value != blank or filter.min_value.value != blank
          assign has_active_filters = true
          break
        endif
      else
        if filter.active_values.size > 0
          assign has_active_filters = true
          break
        endif
      endif
    endfor
  -%}

  {%- capture sizes -%}
    {%- if stack -%}
      (max-width: 699px) calc(100vw / {{ section.settings.products_per_row_mobile | default: 2 }}), (max-width: 999px) calc(100vw / {{ section.settings.products_per_row_desktop | default: 4 | at_most: 3 }} - 64px), calc(100vw / {{ section.settings.products_per_row_desktop | default: 4 }})
    {%- else -%}
      (max-width: 699px) 74vw, (max-width: 999px) 38vw, calc(100vw / {{ section.settings.products_per_row_desktop | default: 4 }})
    {%- endif -%}
  {%- endcapture -%}

  {%- for product in products -%}
    {%- for block in blocks -%}
      {%- liquid
        # Sengefabrikken: a promo block at the third position would split the row with the second and third cards, so it is moved after this row
        assign promo_position = block.settings.position

        if card_style == 'sengefabrikken' and promo_position == 3
          assign promo_position = 4
        endif

        # Sengefabrikken: the collection always has the default filters (size and color) active, so the blocks are still shown when filtered
        assign hide_promo = has_active_filters

        if card_style == 'sengefabrikken'
          assign hide_promo = false
        endif
      -%}

      {%- if hide_promo or paginate.current_page > 1 or forloop.parentloop.index != promo_position -%}
        {%- continue -%}
      {%- endif -%}

      <div class="product-list__promo {% if block.settings.image == blank and settings.product_listing_spacing == 'none' %}outline{% endif %} color-scheme color-scheme--{{ block.settings.color_scheme.id }}" {% if settings.stagger_products %}reveal-on-scroll="true"{% endif %} style="--product-list-promo-row-span: {{ block.settings.size | split: '_' | last }}; --product-list-promo-column-span: {{ block.settings.size | split: '_' | first }}" {{ block.shopify_attributes }}>
        <div class="content-box min-h-full">
          <div class="content-box__background-media with-overlay" style="--overlay: {{ block.settings.overlay_color.rgb }} / {{ block.settings.overlay_opacity | divided_by: 100.0 }}">
            {%- liquid
              if block.type == 'image'
                if block.settings.image != blank
                  render 'media', media: block.settings.image, mobile_media: block.settings.mobile_image
                endif

              elsif block.type == 'video'
                if block.settings.video != blank
                  render 'media', media: block.settings.video, mobile_media: block.settings.mobile_video, autoplay: true, loop: true, muted: true, controls: false, preload: forloop.first, show_play_button: false
                endif
              endif
            -%}
          </div>

          {%- if block.settings.heading != blank or block.settings.content != blank or block.settings.subheading != blank -%}
            <div class="{{ block.settings.content_position }}">
              <div class="prose prose-justify-{{ block.settings.content_position | split: '-' | last }}">
                {%- if block.settings.subheading != blank -%}
                  {%- render 'subheading', content: block.settings.subheading -%}
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  {%- render 'heading', content: block.settings.heading, style: block.settings.heading_size -%}
                {%- endif -%}

                {%- if block.settings.content != blank -%}
                  <div class="max-w-xs">
                    {{- block.settings.content -}}
                  </div>
                {%- endif -%}

                {%- if block.settings.button_text -%}
                  {%- render 'button',
                      content: block.settings.button_text,
                      href: block.settings.url,
                      style: block.settings.style,
                      external: block.settings.open_in_new_tab
                  -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- comment -%}
      Sengefabrikken: with two columns, every third card (starting with the first one) is a wide card and the two others
      are shown next to each other. Without two columns, every card is wide. In both cases, the second and third cards are
      wrapped in a row with its own full width background.
    {%- endcomment -%}
    {%- if card_style == 'sengefabrikken' -%}
      {%- liquid
        assign sengefabrikken_card_index = forloop.index0 | modulo: 3
        assign sengefabrikken_card_wide = true

        if card_two_columns and sengefabrikken_card_index != 0
          assign sengefabrikken_card_wide = false
        endif

        if forloop.index == 2
          echo '<div class="sengefabrikken-card-row" style="--sengefabrikken-card-row-background: ' | append: card_row_background | append: '">'
        endif

        render 'sengefabrikken-product-card', product: product, wide: sengefabrikken_card_wide, position: forloop.index

        if forloop.index == 3 or forloop.index == 2 and forloop.last
          echo '</div>'
        endif
      -%}
    {%- else -%}
      {%- render 'product-card', product: product, reveal: true, allow_highlight: allow_highlight, sizes: sizes, force_no_border: spotlight, section_color_scheme: section_color_scheme, prefix_id: prefix_id, position: forloop.index -%}
    {%- endif -%}
  {%- else -%}
    {%- if show_placeholder -%}
      {%- for i in (1..4) -%}
        {%- render 'product-card-placeholder', loop_index: i -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}
</product-list>