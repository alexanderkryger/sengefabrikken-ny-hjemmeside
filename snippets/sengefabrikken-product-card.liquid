{%- doc -%}
Sengefabrikken: product card used on the collection page when the "Sengefabrikken" card style is selected. The cards are
laid out as one wide card (media next to the info) followed by two cards next to each other (see the product-list
snippet).

It shows:
- the ribbon matching the product tags (theme settings > Sengefabrikken ribbons)
- the splash with the saving in percent, or the "custom.splash_text" metafield when the product is not on sale
- a label from the product tags ("__label:Få tilbage") and the Danish quality icon
  ("custom.dansk_produceret_kvalitetsseng_ikon" metafield)
- the delivery time badge ("custom.leveringstid" metafield)
- the bullet list from the "custom.product_card_h_jre_side_tekst" metaobject (title and content, where "**" is
  replaced by a checkmark)

@param {object} product - the product to render
@param {boolean} [wide] - if set to true, the media is shown next to the info on desktop
@param {number} [position] - the position of the card in the list, used to eagerly load the first images
{%- enddoc -%}

{%- liquid
  assign card_variant = product.selected_or_first_available_variant
  assign splash_text = product.metafields.custom.splash_text.value
  assign is_on_sale = false

  if card_variant.compare_at_price > card_variant.price
    assign is_on_sale = true
    assign saving = card_variant.compare_at_price | minus: card_variant.price | times: 100.0 | divided_by: card_variant.compare_at_price | round
  endif

  assign ribbon_index = 0

  for ribbon_number in (1..6)
    assign ribbon_text_setting = 'ribbon_text_' | append: ribbon_number
    assign ribbon_text = settings[ribbon_text_setting] | strip

    if ribbon_text != blank and product.tags contains ribbon_text
      assign ribbon_index = ribbon_number
      assign ribbon_color_setting = 'ribbon_color_' | append: ribbon_number
      assign ribbon_text_color_setting = 'ribbon_text_color_' | append: ribbon_number
      break
    endif
  endfor

  # "Fabrikkens - Komfort | Kontinental (Sort) 180x200 cm." is shown as "Kontinental - 180x200 cm." and "Fabrikkens Komfort"
  if product.title contains ' | '
    assign card_title = product.title | split: ' | ' | first | remove: ' -' | strip
    assign card_type = product.title | split: ' | ' | last | split: '(' | first | strip
    assign card_size = product.title | split: ')' | last | strip

    if card_size != blank and card_size != card_type
      assign card_subtitle = card_type | append: ' - ' | append: card_size
    else
      assign card_subtitle = card_type
    endif
  else
    assign card_title = product.title
    assign card_subtitle = blank
  endif

  if wide
    assign card_sizes = '(max-width: 999px) 100vw, 50vw'
  else
    assign card_sizes = '(max-width: 699px) 100vw, 50vw'
  endif

  if position <= 3
    assign card_loading = 'eager'
  else
    assign card_loading = 'lazy'
  endif

  assign bullets = product.metafields.custom.product_card_h_jre_side_tekst.value

  assign show_quality_icon = false

  if product.metafields.custom.dansk_produceret_kvalitetsseng_ikon != blank
    assign show_quality_icon = true
  endif

  # A tag such as "__label:Få tilbage" is shown as a label in the top corner of the media
  assign product_label = blank

  for tag in product.tags
    if tag contains '__label:'
      assign product_label = tag | split: '__label:' | last | strip
      break
    endif
  endfor
-%}

{%- capture quality_icon -%}
  <img class="sengefabrikken-card__quality-icon" src="{{ 'dansk-kvalitet.svg' | asset_url }}" alt="Danskproduceret kvalitetsseng" width="107" height="107" loading="lazy">
{%- endcapture -%}

<article class="sengefabrikken-card {% if wide %}sengefabrikken-card--wide{% endif %} {% if ribbon_index > 0 %}sengefabrikken-card--ribbon{% endif %} color-scheme color-scheme--{{ settings.product_card_color_scheme.id }}" {% if ribbon_index > 0 %}style="--sengefabrikken-card-ribbon-background: {{ settings[ribbon_color_setting] }}; --sengefabrikken-card-ribbon-text-color: {{ settings[ribbon_text_color_setting] }}"{% endif %}>
  {%- if ribbon_index > 0 -%}
    <p class="sengefabrikken-card__ribbon">{{ ribbon_text }}</p>
  {%- endif -%}

  <a href="{{ product.url }}" class="sengefabrikken-card__media">
    {%- if product.featured_media != blank -%}
      {{- product.featured_media | image_url: width: product.featured_media.width | image_tag: loading: card_loading, sizes: card_sizes, widths: '400,600,800,1000,1200,1400,1600,1800', class: 'sengefabrikken-card__image' -}}
    {%- else -%}
      {{- 'product-1' | placeholder_svg_tag: 'sengefabrikken-card__image placeholder' -}}
    {%- endif -%}

    {%- if is_on_sale or splash_text != blank -%}
      <span class="sengefabrikken-card__splash">
        <img src="{{ 'splash-icon.svg' | asset_url }}" alt="" width="142" height="142" loading="lazy">

        <span class="sengefabrikken-card__splash-text">
          {%- if is_on_sale -%}
            -{{ saving }}%
          {%- else -%}
            {{- splash_text -}}
          {%- endif -%}
        </span>
      </span>
    {%- endif -%}

    {%- comment -%}On the wide card, the quality icon is shown next to the title instead{%- endcomment -%}
    {%- if product_label != blank or show_quality_icon and wide != true -%}
      <span class="sengefabrikken-card__corner">
        {%- if product_label != blank -%}
          <span class="sengefabrikken-card__label">{{ product_label }}</span>
        {%- endif -%}

        {%- if show_quality_icon and wide != true -%}
          {{- quality_icon -}}
        {%- endif -%}
      </span>
    {%- endif -%}

    {%- if product.metafields.custom.leveringstid != blank -%}
      <span class="sengefabrikken-card__delivery">Levering ({{ product.metafields.custom.leveringstid }})</span>
    {%- endif -%}
  </a>

  {%- capture card_title -%}
    <a href="{{ product.url }}" class="v-stack gap-0.5">
      {%- if card_subtitle != blank -%}
        <span class="text-sm text-subdued">{{ card_subtitle }}</span>
      {%- endif -%}

      <span class="sengefabrikken-card__title heading">{{ card_title }}</span>
    </a>
  {%- endcapture -%}

  {%- capture card_price -%}
    <div class="v-stack">
      <span class="sengefabrikken-card__price">{{ card_variant.price | money_without_trailing_zeros }}</span>

      {%- if is_on_sale -%}
        <span class="text-xs text-subdued line-through">Vejl. udsalgspris: {{ card_variant.compare_at_price | money_without_trailing_zeros }}</span>
      {%- elsif splash_text != blank -%}
        <span class="text-xs text-subdued">{{ splash_text }}</span>
      {%- endif -%}
    </div>
  {%- endcapture -%}

  {%- capture card_bullets -%}
    {%- if bullets != blank -%}
      {%- assign bullet_list = bullets.content.value | strip_html | split: '**' -%}

      <div class="sengefabrikken-card__bullets">
        {%- if bullets.title.value != blank -%}
          <p class="sengefabrikken-card__bullets-title">{{ bullets.title.value }}</p>
        {%- endif -%}

        <ul class="sengefabrikken-card__bullet-list" role="list">
          {%- for bullet in bullet_list -%}
            {%- assign bullet_text = bullet | strip -%}

            {%- if bullet_text != blank -%}
              <li class="sengefabrikken-card__bullet">
                {%- render 'icon' with 'success-checkmark', width: 12 -%}
                <span>{{ bullet_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- capture card_rating -%}
    {%- if product.metafields.reviews.rating.value != blank -%}
      {%- liquid
        assign rating_value = product.metafields.reviews.rating.value.rating
        assign rating_max = product.metafields.reviews.rating.value.scale_max | default: 5
        assign rating_out_of_five = rating_value | times: 5.0 | divided_by: rating_max
        assign rating_count = product.metafields.reviews.rating_count.value | default: 0
      -%}

      <div class="sengefabrikken-card__rating">
        <span class="sengefabrikken-card__stars" role="img" aria-label="{{ rating_value | round: 1 }} / {{ rating_max }}">
          {%- for star in (1..5) -%}
            {%- assign star_fill = rating_out_of_five | minus: forloop.index0 | at_least: 0 | at_most: 1 | times: 100 | round -%}

            <span class="sengefabrikken-card__star" style="--sengefabrikken-card-star-fill: {{ star_fill }}%">
              <svg aria-hidden="true" focusable="false" width="12" viewBox="0 0 24 24"><path fill="#fff" d="m12 2 2.9 6.9 7.1.6-5.4 4.7 1.6 7L12 17.3l-6.2 3.9 1.6-7L2 9.5l7.1-.6z"/></svg>
            </span>
          {%- endfor -%}
        </span>

        <span class="text-sm">{{ rating_count }} anmeldelser</span>
      </div>
    {%- endif -%}
  {%- endcapture -%}

  <div class="sengefabrikken-card__info">
    {%- if wide -%}
      <div class="sengefabrikken-card__header">
        {{- card_title -}}

        {%- if show_quality_icon -%}
          {{- quality_icon -}}
        {%- endif -%}
      </div>

      {{- card_bullets -}}
      {{- card_price -}}
      {{- card_rating -}}
    {%- else -%}
      <div class="sengefabrikken-card__details">
        <div class="v-stack gap-4">
          {{- card_title -}}
          {{- card_price -}}
        </div>

        {{- card_bullets -}}
      </div>

      {{- card_rating -}}
    {%- endif -%}
  </div>
</article>
